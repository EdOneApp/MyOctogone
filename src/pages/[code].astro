---
import BaseLayout from '../layouts/BaseLayout.astro';
import ErrorContent from '../sections/ErrorContent.astro';
import { errorPages, type ErrorCode } from '../data/errors';
export function getStaticPaths() { return Object.keys(errorPages).filter(code=>code!=='404').map(code=>({params:{code},props:{code}})); }
interface Props { code: ErrorCode; }
const {code} = Astro.props;
const page=errorPages[code];
---
<BaseLayout title={`${page[0]}, Octogone`} description={page[1]} noindex><ErrorContent code={code} lang="fr" /></BaseLayout>
