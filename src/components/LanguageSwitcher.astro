---
import { getLangFromUrl, switchLangPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const other = lang === 'fr' ? 'en' : 'fr';
const href = switchLangPath(Astro.url.pathname, other);
---

<a
  href={href}
  class="inline-flex items-center gap-1.5 rounded-full border border-[#333a5c] px-3 py-1.5 font-display text-xs font-semibold text-[#c7cbe0] transition-colors hover:border-cyan-400/60 hover:text-white"
  aria-label={other === 'en' ? 'Switch to English' : 'Passer en français'}
  data-astro-reload
>
  <span class:list={[lang === 'fr' && 'text-white']}>FR</span>
  <span class="text-[#5c6180]">/</span>
  <span class:list={[lang === 'en' && 'text-white']}>EN</span>
</a>
