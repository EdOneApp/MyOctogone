---
import { getLangFromUrl, switchLangPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const other = lang === 'fr' ? 'en' : 'fr';
const href = switchLangPath(Astro.url.pathname, other);
---

<a
  href={href}
  class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-line-cool)] px-3 py-1.5 font-display text-xs font-semibold text-[var(--color-body)] transition-colors hover:border-[var(--color-navy)] hover:text-[var(--color-navy)]"
  aria-label={other === 'en' ? 'Switch to English' : 'Passer en français'}
  data-astro-reload
>
  <span class:list={[lang === 'fr' && 'text-[var(--color-navy)]']}>FR</span>
  <span class="text-[var(--color-faint)]">/</span>
  <span class:list={[lang === 'en' && 'text-[var(--color-navy)]']}>EN</span>
</a>
