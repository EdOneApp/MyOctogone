---
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';
import { getNav, getCta, getLangSwitch } from '../i18n/nav';
import { ui } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileNav from './react/MobileNav.tsx';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const nav = getNav(lang);
const cta = getCta(lang);
const langSwitch = getLangSwitch(lang, Astro.url.pathname);
const home = localizePath('/', lang);
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-[background,box-shadow,border-color] duration-300"
  data-scrolled="false"
>
  <div class="container-page flex h-[76px] items-center justify-between gap-6">
    <a href={home} class="flex items-center gap-2.5" aria-label="Octogone — accueil">
      <span
        class="grid h-9 w-9 place-items-center rounded-xl bg-[var(--color-navy)] text-[var(--color-amber)]"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M8 3h8l5 5v8l-5 5H8l-5-5V8l5-5Z"
            stroke="currentColor"
            stroke-width="2"
            stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="font-display text-xl font-bold tracking-tight text-[var(--color-navy)]">
        OCTO<span class="text-[var(--color-amber-600)]">GONE</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label={t('nav.menu')}>
      {
        nav.map((l) => {
          const active =
            l.href === current || (l.href.includes('#') && current === home);
          return (
            <a
              href={l.href}
              class:list={[
                'rounded-full px-3.5 py-2 font-display text-sm font-medium transition-colors',
                active
                  ? 'text-[var(--color-navy)]'
                  : 'text-[var(--color-muted)] hover:text-[var(--color-navy)]',
              ]}
            >
              {l.label}
            </a>
          );
        })
      }
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <LanguageSwitcher />
      <a href={cta.href} class="btn btn-primary !px-5 !py-2.5 text-sm">
        {t('nav.contact')}
      </a>
    </div>

    <MobileNav
      client:load
      links={nav}
      cta={cta}
      langSwitch={langSwitch}
      openLabel={ui[lang]['nav.menu']}
      closeLabel={ui[lang]['nav.close']}
    />
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.getElementById('site-header');
    if (!header) return;
    const onScroll = () => {
      header.dataset.scrolled = String(window.scrollY > 12);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:after-swap', onScroll);
  })();
</script>

<style>
  #site-header[data-scrolled='true'] {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-line-cool);
    box-shadow: 0 8px 30px -18px rgba(28, 41, 81, 0.25);
  }
</style>
