---
import { getLangFromUrl, useTranslations, localizePath, tf, asset } from '../i18n/utils';
import { subsidiaries } from '../data/subsidiaries';
import { getNav } from '../i18n/nav';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const nav = getNav(lang);
const year = new Date().getFullYear();
const email = 'octogone.techs@gmail.com';
---

<footer class="border-t border-[var(--color-line-cool)] bg-[var(--color-cream)]">
  <div class="container-page grid gap-12 py-16 md:grid-cols-[1.5fr_1fr_1fr] md:py-20">
    <div>
      <img
        src={asset('assets/logo-lockup.png')}
        alt="Octogone — La Boîte à Génies"
        width="180"
        height="120"
        class="h-16 w-auto"
      />
      <p class="mt-5 max-w-xs text-sm leading-relaxed text-[var(--color-body)]">
        {t('footer.tagline')}
      </p>
      <a
        href={`mailto:${email}`}
        class="mt-4 inline-block text-sm font-medium text-[var(--color-navy)] underline-offset-2 hover:text-[var(--color-amber-600)] hover:underline"
      >
        {email}
      </a>
    </div>

    <div>
      <h2 class="font-display text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-muted)]">
        {t('footer.nav')}
      </h2>
      <ul class="mt-4 space-y-2.5">
        {
          nav.map((l) => (
            <li>
              <a
                href={l.href}
                class="text-sm text-[var(--color-body)] transition-colors hover:text-[var(--color-navy)]"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="font-display text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-muted)]">
        {t('label.subsidiaries')}
      </h2>
      <ul class="mt-4 grid grid-cols-1 gap-2.5 sm:grid-cols-2 md:grid-cols-1">
        {
          subsidiaries.map((s) => (
            <li>
              <a
                href={localizePath(`/filiales/${s.slug}`, lang)}
                class="text-sm text-[var(--color-body)] transition-colors hover:text-[var(--color-navy)]"
              >
                {tf(s.sector, lang)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-[var(--color-line-cool)]">
    <div
      class="container-page flex flex-col items-center justify-between gap-3 py-6 text-xs text-[var(--color-muted)] sm:flex-row"
    >
      <p>© {year} Octogone. {t('footer.rights')}</p>
      <p>{t('footer.madeIn')} — Abidjan, Côte d’Ivoire 🇨🇮</p>
    </div>
  </div>
</footer>
