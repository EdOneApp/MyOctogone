---
import { getLangFromUrl, useTranslations, localizePath, tf } from '../i18n/utils';
import { subsidiaries } from '../data/subsidiaries';
import { getNav } from '../i18n/nav';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const nav = getNav(lang);
const year = new Date().getFullYear();
---

<footer class="relative mt-24 border-t border-[#23273d] bg-[#07080e]">
  <div class="container-page grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr] md:py-20">
    <div>
      <div class="flex items-center gap-2.5">
        <span
          class="clip-octagon-sm grid h-9 w-9 place-items-center bg-gradient-to-br from-cyan-400 to-blue-600 text-[#04121c]"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M7.5 3h9L21 7.5v9L16.5 21h-9L3 16.5v-9L7.5 3Z"
              stroke="currentColor"
              stroke-width="2"
              stroke-linejoin="round"
            ></path>
          </svg>
        </span>
        <span class="font-display text-lg font-bold tracking-tight text-white">OCTOGONE</span>
      </div>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-[#8b90ad]">
        {t('footer.tagline')}
      </p>
      <a
        href="mailto:contact@myoctogone.com"
        class="mt-4 inline-block text-sm text-cyan-300 underline-offset-2 hover:underline"
      >
        contact@myoctogone.com
      </a>
    </div>

    <div>
      <h2 class="font-display text-xs font-semibold uppercase tracking-[0.22em] text-[#5c6180]">
        {t('footer.nav')}
      </h2>
      <ul class="mt-4 space-y-2.5">
        {
          nav.map((l) => (
            <li>
              <a href={l.href} class="text-sm text-[#8b90ad] transition-colors hover:text-white">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="font-display text-xs font-semibold uppercase tracking-[0.22em] text-[#5c6180]">
        {t('label.subsidiaries')}
      </h2>
      <ul class="mt-4 grid grid-cols-1 gap-2.5 sm:grid-cols-2 md:grid-cols-1">
        {
          subsidiaries.map((s) => (
            <li>
              <a
                href={localizePath(`/filiales/${s.slug}`, lang)}
                class="text-sm text-[#8b90ad] transition-colors hover:text-white"
              >
                {tf(s.sector, lang)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-[#23273d]">
    <div
      class="container-page flex flex-col items-center justify-between gap-3 py-6 text-xs text-[#5c6180] sm:flex-row"
    >
      <p>© {year} Octogone. {t('footer.rights')}</p>
      <p>{t('footer.madeIn')} — Abidjan, Côte d’Ivoire 🇨🇮</p>
    </div>
  </div>
</footer>
