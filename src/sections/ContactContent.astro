---
import { useTranslations, tf } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { subsidiaries } from '../data/subsidiaries';
import { ui } from '../i18n/ui';
import Reveal from '../components/Reveal.astro';
import GradientText from '../components/react/GradientText.tsx';
import ContactForm from '../components/react/ContactForm.tsx';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT;
const email = 'contact@myoctogone.com';

const labels = {
  name: ui[lang]['contact.form.name'],
  email: ui[lang]['contact.form.email'],
  company: ui[lang]['contact.form.company'],
  subject: ui[lang]['contact.form.subject'],
  message: ui[lang]['contact.form.message'],
  send: ui[lang]['cta.send'],
  sending: ui[lang]['cta.sending'],
  success: ui[lang]['contact.form.success'],
  error: ui[lang]['contact.form.error'],
  fallback: ui[lang]['contact.form.fallback'],
};

const subjects = [
  lang === 'fr' ? 'Renseignement général' : 'General enquiry',
  ...subsidiaries.map((s) => `Octogone ${tf(s.sector, lang)}`),
];
---

<section class="relative isolate overflow-hidden pt-40">
  <div class="absolute inset-0 -z-10">
    <div class="bg-grid absolute inset-0 opacity-60"></div>
    <div
      class="glow-blob left-[10%] top-0 h-[32rem] w-[32rem]"
      style="background: radial-gradient(circle, rgba(37,99,235,0.4), transparent 62%)"
    >
    </div>
    <div
      class="glow-blob right-[6%] top-[30%] h-[26rem] w-[26rem]"
      style="background: radial-gradient(circle, rgba(168,85,247,0.3), transparent 62%)"
    >
    </div>
  </div>

  <div class="container-page grid gap-14 pb-24 lg:grid-cols-[0.85fr_1.15fr]">
    <div>
      <Reveal>
        <span class="eyebrow">{t('nav.contact')}</span>
      </Reveal>
      <h1 class="mt-6 font-display text-[clamp(2.2rem,5vw,3.6rem)] font-bold leading-[1.06] text-white">
        <GradientText client:load text={t('contact.title')} />
      </h1>
      <Reveal delay={0.12}>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-[#c7cbe0]">{t('contact.subtitle')}</p>
      </Reveal>

      <Reveal delay={0.2} class="mt-10 space-y-6">
        <div>
          <h2 class="font-display text-xs font-semibold uppercase tracking-[0.2em] text-[#5c6180]">
            {t('contact.direct')}
          </h2>
          <a href={`mailto:${email}`} class="mt-2 block text-cyan-300 hover:underline">{email}</a>
        </div>
        <div>
          <h2 class="font-display text-xs font-semibold uppercase tracking-[0.2em] text-[#5c6180]">
            Abidjan
          </h2>
          <p class="mt-2 text-sm text-[#8b90ad]">Côte d’Ivoire 🇨🇮</p>
        </div>
      </Reveal>
    </div>

    <Reveal delay={0.1}>
      <ContactForm
        client:load
        endpoint={endpoint}
        email={email}
        labels={labels}
        subjects={subjects}
      />
      {
        !endpoint && import.meta.env.DEV && (
          <p class="mt-3 text-xs text-[#5c6180]">
            Dev note — set <code>PUBLIC_CONTACT_ENDPOINT</code> (Formspree / Web3Forms)
            for direct submission. Falls back to <code>mailto:</code> otherwise.
          </p>
        )
      }
    </Reveal>
  </div>
</section>
