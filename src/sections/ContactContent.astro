---
import { useTranslations, tf, asset, localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { subsidiaries } from '../data/subsidiaries';
import { ui } from '../i18n/ui';
import Reveal from '../components/Reveal.astro';
import ContactForm from '../components/react/ContactForm.tsx';
import AppointmentCalendar from '../components/AppointmentCalendar.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const email = 'octogone.techs@gmail.com';

const labels = {
  name: ui[lang]['contact.form.name'],
  email: ui[lang]['contact.form.email'],
  company: ui[lang]['contact.form.company'],
  subject: ui[lang]['contact.form.subject'],
  message: ui[lang]['contact.form.message'],
  fallback: ui[lang]['contact.form.fallback'],
};

const subjects = [
  lang === 'fr' ? 'Renseignement général' : 'General enquiry',
  ...subsidiaries.map((s) => `Octogone ${tf(s.sector, lang)}`),
];
---

<section class="relative overflow-hidden bg-[var(--color-cream)]">
  <div class="dot-grid absolute inset-0 opacity-60"></div>
  <div class="blob left-[6%] top-0 h-[24rem] w-[24rem]" style="background: rgba(245,166,35,0.18)"></div>

  <div class="container-page relative grid gap-14 pb-20 pt-36 lg:grid-cols-[0.85fr_1.15fr] lg:pt-44">
    <div>
      <Reveal>
        <span class="eyebrow">{t('nav.contact')}</span>
      </Reveal>
      <h1 class="mt-6 font-display text-[clamp(2.2rem,5vw,3.4rem)] font-bold leading-[1.08] text-[var(--color-ink)]">
        {t('contact.title')}
      </h1>
      <Reveal delay={0.1}>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-[var(--color-body)]">{lang === 'fr' ? 'Décrivez votre besoin sur WhatsApp ou choisissez un créneau pour en discuter avec Daniel Guedegbe.' : 'Share your needs on WhatsApp or choose a time to discuss them with Daniel Guedegbe.'}</p>
      </Reveal>

      <a href="#rendez-vous" class="text-link mt-5">{lang === 'fr' ? 'Réserver un rendez-vous de 30 min' : 'Book a 30-minute appointment'} <span>↗</span></a>
      <Reveal delay={0.18} class="mt-10 space-y-6">
        <div>
          <h2 class="font-display text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-muted)]">
            {t('contact.direct')}
          </h2>
          <a href={`mailto:${email}`} class="mt-2 block font-medium text-[var(--color-navy)] hover:text-[var(--color-amber-600)] hover:underline">
            {email}
          </a>
        </div>
        <div>
          <h2 class="font-display text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-muted)]">
            Abidjan
          </h2>
          <p class="mt-2 text-sm text-[var(--color-body)]">Côte d’Ivoire 🇨🇮</p>
        </div>
      </Reveal>
      <img class="contact-visual" src={asset('images/architecture.jpg')} alt={lang === 'fr' ? 'Espace de travail, photographie d’illustration' : 'Workspace, illustrative photograph'} width="900" height="600" />
    </div>

    <Reveal delay={0.1}>
      <ContactForm
        client:load
        lang={lang}
        email={email}
        labels={labels}
        subjects={subjects}
        privacyHref={localizePath('/confidentialite',lang)}
        privacyLabel={lang === 'fr' ? 'Utilisation de vos données : politique de confidentialité' : 'How your data is used: privacy policy'}
      />
    </Reveal>
  </div>
</section>

<AppointmentCalendar lang={lang} />
