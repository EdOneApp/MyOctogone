---
import { errorPages, type ErrorCode } from '../data/errors';
import { localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
interface Props { code: ErrorCode; lang: Lang; }
const {code,lang} = Astro.props;
const fr = lang === 'fr';
const data = errorPages[code];
const number = code==='maintenance' ? 'PAUSE' : code==='hors-ligne' ? 'OFFLINE' : code;
const title=data[fr?0:2], body=data[fr?1:3];
---
<section class="error-stage"><div class="error-orbit" aria-hidden="true"></div><div class="container-page error-grid"><div class="error-copy"><span class="eyebrow">OCTOGONE / {fr ? 'ON GARDE LE LIEN' : 'LET’S STAY CONNECTED'}</span><span class="error-label">{fr ? (code==='maintenance' ? 'Maintenance' : code==='hors-ligne' ? 'Connexion indisponible' : `Erreur ${code}`) : (code==='maintenance' ? 'Maintenance' : code==='hors-ligne' ? 'Offline' : `Error ${code}`)}</span><h1>{title}</h1><p>{body}</p><div class="error-actions"><a href={localizePath('/',lang)} class="btn btn-amber">{fr ? 'Retour à l’accueil' : 'Back to home'} <span>↗</span></a>{code!=='404'&&code!=='410'&&code!=='403'&&code!=='401' && <button type="button" class="error-retry">{fr ? 'Réessayer' : 'Try again'} ↻</button>}</div><a class="error-email" href="mailto:octogone.techs@gmail.com">octogone.techs@gmail.com <span>↗</span></a></div><div class:list={['error-art',number.length>3&&'error-art-word']} aria-hidden="true"><span class="error-ring"></span><b>{number}</b><i>✳</i><small>{fr ? 'L’AMBITION CONTINUE.' : 'THE AMBITION CONTINUES.'}</small></div></div></section>
<section class="error-next"><div class="container-page"><p>{fr ? 'La visite continue par ici' : 'Continue exploring'}</p><div><a href={`${localizePath('/',lang)}#filiales`}><span>01</span>{fr ? 'Nos métiers' : 'Our sectors'} <b>↗</b></a><a href={`${localizePath('/',lang)}#realisations`}><span>02</span>{fr ? 'Nos projets' : 'Our projects'} <b>↗</b></a><a href={localizePath('/contact',lang)}><span>03</span>{fr ? 'Nous contacter' : 'Contact us'} <b>↗</b></a></div></div></section>
<script>
 const bindRetry = () => {document.querySelector<HTMLButtonElement>('.error-retry')?.addEventListener('click',()=>window.location.reload(),{once:true});};
 document.addEventListener('astro:page-load',bindRetry);
</script>
