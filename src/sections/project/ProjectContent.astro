---
import { useTranslations, localizePath, tf, asset } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import type { Project } from '../../data/types';
import { projectsBySubsidiary } from '../../data/projects';
import { subsidiaryBySlug } from '../../data/subsidiaries';
import CardGrid, { type CardItem } from '../../components/react/CardGrid.tsx';
import Reveal from '../../components/Reveal.astro';
import CTA from '../CTA.astro';

interface Props {
  project: Project;
  lang: Lang;
}
const { project: p, lang } = Astro.props;
const t = useTranslations(lang);
const parent = subsidiaryBySlug(p.subsidiarySlug)!;

const related = projectsBySubsidiary(p.subsidiarySlug)
  .filter((x) => x.slug !== p.slug)
  .slice(0, 3);

const relatedItems: CardItem[] = related.map((r) => ({
  title: r.title,
  subtitle: tf(r.category, lang),
  description: tf(r.summary, lang),
  href: localizePath(`/projets/${r.slug}`, lang),
  image: r.status === 'verified' ? asset(r.image) : undefined,
  tags: r.stack,
  cta: t('cta.viewProject'),
}));

const showHeroImage = p.status === 'verified';

const hostname = (u?: string) => {
  if (!u) return undefined;
  try {
    return new URL(u).hostname.replace(/^www\./, '');
  } catch {
    return u;
  }
};
---

<article>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-[var(--color-cream)]">
    <div class="dot-grid absolute inset-0 opacity-60"></div>
    <div class="container-page relative pb-14 pt-36 lg:pt-44">
      <Reveal>
        <a href={localizePath(`/filiales/${parent.slug}`, lang)} class="link-arrow mb-8 text-[var(--color-muted)]">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          {parent.name}
        </a>
      </Reveal>

      <div class="flex flex-wrap items-center gap-3">
        <span class="chip">{tf(p.category, lang)}</span>
        {p.year && <span class="chip">{t('label.year')} {p.year}</span>}
        {p.award && <span class="chip chip-amber">🏆 {tf(p.award, lang)}</span>}
      </div>

      <h1 class="mt-6 max-w-4xl font-display text-[clamp(2.3rem,5.4vw,4rem)] font-bold leading-[1.06] text-[var(--color-ink)]">
        {p.title}
      </h1>
      <Reveal delay={0.1}>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[var(--color-body)]">{tf(p.summary, lang)}</p>
      </Reveal>

      <Reveal delay={0.16}>
        <div class="mt-8 flex flex-wrap gap-4">
          {
            p.url && (
              <a href={p.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                {t('cta.viewProject')} · {hostname(p.url)}
              </a>
            )
          }
          {
            p.repo && (
              <a href={p.repo} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
                {t('cta.viewRepo')}
              </a>
            )
          }
        </div>
      </Reveal>
    </div>

    <div class="container-page relative pb-16">
      <Reveal>
        <div class="clip-octagon overflow-hidden border border-[var(--color-line-cool)] bg-white shadow-[var(--shadow-lift)]">
          {
            showHeroImage ? (
              <img src={asset(p.image)} alt={p.title} class="w-full object-cover" />
            ) : (
              <div class="dot-grid relative aspect-[16/7] w-full bg-[var(--color-cream-2)]">
                <img
                  src={asset(parent.icon)}
                  alt=""
                  aria-hidden="true"
                  class="absolute right-10 top-1/2 hidden h-28 w-28 -translate-y-1/2 object-contain opacity-90 sm:block"
                />
                <span class="absolute bottom-6 left-8 font-display text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-faint)]">
                  {tf(p.category, lang)}
                </span>
              </div>
            )
          }
        </div>
      </Reveal>
    </div>
  </section>

  <!-- Body -->
  <section class="section bg-white">
    <div class="container-page grid gap-14 lg:grid-cols-[1.4fr_0.6fr]">
      <Reveal class="space-y-5">
        {p.description.map((para) => <p class="text-lg leading-relaxed text-[var(--color-body)]">{tf(para, lang)}</p>)}
      </Reveal>

      <aside class="space-y-8">
        <div>
          <h2 class="font-display text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-muted)]">
            {t('label.stack')}
          </h2>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {p.stack.map((s) => <span class="chip">{s}</span>)}
          </div>
        </div>
        <div>
          <h2 class="font-display text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-muted)]">
            {t('label.subsidiary')}
          </h2>
          <a
            href={localizePath(`/filiales/${parent.slug}`, lang)}
            class="mt-3 inline-block font-display text-base font-semibold text-[var(--color-navy)] hover:text-[var(--color-amber-600)]"
          >
            {parent.name}
          </a>
        </div>
        {
          p.url && (
            <div>
              <h2 class="font-display text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-muted)]">
                {t('label.online')}
              </h2>
              <a href={p.url} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block text-sm text-[var(--color-navy)] hover:underline">
                {hostname(p.url)}
              </a>
            </div>
          )
        }
      </aside>
    </div>
  </section>

  {
    relatedItems.length > 0 && (
      <section class="section bg-[var(--color-cream)] pt-0">
        <div class="container-page">
          <Reveal>
            <h2 class="font-display text-xl font-bold text-[var(--color-ink)]">{t('label.relatedProjects')}</h2>
          </Reveal>
          <div class="mt-10">
            <CardGrid client:visible items={relatedItems} columns="sm:grid-cols-2 lg:grid-cols-3" />
          </div>
        </div>
      </section>
    )
  }

  <CTA lang={lang} />
</article>
