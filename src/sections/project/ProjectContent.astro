---
import { useTranslations, localizePath, tf, asset } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import type { Project } from '../../data/types';
import { projectsBySubsidiary } from '../../data/projects';
import { subsidiaryBySlug } from '../../data/subsidiaries';
import CardGrid, { type CardItem } from '../../components/react/CardGrid.tsx';
import Reveal from '../../components/Reveal.astro';
import GradientText from '../../components/react/GradientText.tsx';
import CTA from '../CTA.astro';

interface Props {
  project: Project;
  lang: Lang;
}
const { project: p, lang } = Astro.props;
const t = useTranslations(lang);
const parent = subsidiaryBySlug(p.subsidiarySlug)!;

const related = projectsBySubsidiary(p.subsidiarySlug)
  .filter((x) => x.slug !== p.slug)
  .slice(0, 3);

const relatedItems: CardItem[] = related.map((r) => ({
  title: r.title,
  subtitle: tf(r.category, lang),
  description: tf(r.summary, lang),
  href: localizePath(`/projets/${r.slug}`, lang),
  image: r.status === 'verified' ? asset(r.image) : undefined,
  accent: parent.accent,
  tags: r.stack,
  cta: t('cta.viewProject'),
}));

const showHeroImage = p.status === 'verified';

const hostname = (u?: string) => {
  if (!u) return undefined;
  try {
    return new URL(u).hostname.replace(/^www\./, '');
  } catch {
    return u;
  }
};
---

<article>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden pt-36">
    <div class="absolute inset-0 -z-10">
      <div class="bg-grid absolute inset-0 opacity-50"></div>
      <div
        class="glow-blob left-[12%] top-[10%] h-[30rem] w-[30rem]"
        style={`background: radial-gradient(circle, ${parent.accent.from}44, transparent 62%)`}
      >
      </div>
    </div>

    <div class="container-page">
      <Reveal>
        <a href={localizePath(`/filiales/${parent.slug}`, lang)} class="link-arrow mb-8 text-[#8b90ad]">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          {parent.name}
        </a>
      </Reveal>

      <div class="flex flex-wrap items-center gap-3">
        <span class="chip">{tf(p.category, lang)}</span>
        {p.year && <span class="chip">{t('label.year')} {p.year}</span>}
        {
          p.award && (
            <span class="chip border-cyan-300/40 text-cyan-200">🏆 {tf(p.award, lang)}</span>
          )
        }
      </div>

      <h1 class="mt-6 max-w-4xl font-display text-[clamp(2.4rem,6vw,4.4rem)] font-bold leading-[1.05] text-white">
        <GradientText client:load text={p.title} />
      </h1>
      <Reveal delay={0.1}>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[#c7cbe0]">{tf(p.summary, lang)}</p>
      </Reveal>

      <Reveal delay={0.18}>
        <div class="mt-8 flex flex-wrap gap-4">
          {
            p.url && (
              <a href={p.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary clip-octagon-sm">
                {t('cta.viewProject')} · {hostname(p.url)}
              </a>
            )
          }
          {
            p.repo && (
              <a href={p.repo} target="_blank" rel="noopener noreferrer" class="btn btn-ghost clip-octagon-sm">
                {t('cta.viewRepo')}
              </a>
            )
          }
        </div>
      </Reveal>
    </div>

    <div class="container-page mt-14">
      <Reveal>
        <div class="clip-octagon relative overflow-hidden border border-[#23273d]">
          {
            showHeroImage ? (
              <img src={asset(p.image)} alt={p.title} class="w-full object-cover" />
            ) : (
              <div
                class="relative aspect-[16/7] w-full"
                style={`background: radial-gradient(120% 120% at 12% 0%, ${parent.accent.from}33, transparent 55%), radial-gradient(120% 120% at 100% 100%, ${parent.accent.to}28, transparent 55%), #080a12`}
              >
                <svg
                  class="absolute inset-0 h-full w-full opacity-50"
                  viewBox="0 0 1200 520"
                  fill="none"
                  preserveAspectRatio="xMidYMid slice"
                  aria-hidden="true"
                >
                  <defs>
                    <pattern id="ph-dots" width="26" height="26" patternUnits="userSpaceOnUse">
                      <circle cx="1.6" cy="1.6" r="1.6" fill={parent.accent.from} fill-opacity="0.16" />
                    </pattern>
                  </defs>
                  <rect width="1200" height="520" fill="url(#ph-dots)" />
                  <path
                    d="M820 90h150l90 90v150l-90 90H820l-90-90V180z"
                    stroke={parent.accent.from}
                    stroke-opacity="0.32"
                    stroke-width="2"
                  />
                  <path
                    d="M880 150h90l54 54v90l-54 54h-90l-54-54v-90z"
                    stroke={parent.accent.to}
                    stroke-opacity="0.26"
                    stroke-width="2"
                  />
                </svg>
                <span
                  class="absolute bottom-6 left-8 font-display text-sm font-semibold uppercase tracking-[0.24em] text-white/45"
                >
                  {tf(p.category, lang)}
                </span>
              </div>
            )
          }
          <div class="absolute inset-0 ring-1 ring-inset ring-white/5"></div>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- Body -->
  <section class="py-20 sm:py-24">
    <div class="container-page grid gap-14 lg:grid-cols-[1.4fr_0.6fr]">
      <Reveal class="space-y-5">
        {p.description.map((para) => <p class="text-lg leading-relaxed text-[#c7cbe0]">{tf(para, lang)}</p>)}
      </Reveal>

      <aside class="space-y-8">
        <div>
          <h2 class="font-display text-xs font-semibold uppercase tracking-[0.2em] text-[#5c6180]">
            {t('label.stack')}
          </h2>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {p.stack.map((s) => <span class="chip">{s}</span>)}
          </div>
        </div>
        <div>
          <h2 class="font-display text-xs font-semibold uppercase tracking-[0.2em] text-[#5c6180]">
            {t('label.subsidiary')}
          </h2>
          <a
            href={localizePath(`/filiales/${parent.slug}`, lang)}
            class="mt-3 inline-block font-display text-base font-semibold text-white hover:text-cyan-300"
          >
            {parent.name}
          </a>
        </div>
        {
          p.url && (
            <div>
              <h2 class="font-display text-xs font-semibold uppercase tracking-[0.2em] text-[#5c6180]">
                {t('label.online')}
              </h2>
              <a
                href={p.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-block text-sm text-cyan-300 hover:underline"
              >
                {hostname(p.url)}
              </a>
            </div>
          )
        }
      </aside>
    </div>
  </section>

  {
    relatedItems.length > 0 && (
      <section class="pb-8">
        <div class="container-page">
          <Reveal>
            <h2 class="font-display text-xl font-bold text-white">{t('label.relatedProjects')}</h2>
          </Reveal>
          <div class="mt-10">
            <CardGrid client:visible items={relatedItems} columns="sm:grid-cols-2 lg:grid-cols-3" />
          </div>
        </div>
      </section>
    )
  }

  <CTA lang={lang} />
</article>
