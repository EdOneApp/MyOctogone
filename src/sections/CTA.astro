---
import { localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; title?: string; subtitle?: string; }
const { lang, title, subtitle } = Astro.props;
const fr = lang === 'fr';
---
<section class="contact-banner"><div class="container-page"><span class="eyebrow">{fr ? 'LA SUITE COMMENCE AVEC VOUS' : 'WHAT COMES NEXT STARTS WITH YOU'}</span><div class="contact-banner-row"><div><h2>{title || (fr ? 'Et si on avançait' : 'Let’s move forward')}<br /><em>{fr ? 'ensemble ?' : 'together.'}</em></h2><p>{subtitle || (fr ? 'Une idée, un besoin, un projet. Prenons le temps d’en parler.' : 'An idea, a need, a project. Let’s take the time to talk.')}</p></div><a href={localizePath('/contact',lang)} class="contact-circle" aria-label={fr ? 'Nous contacter' : 'Contact us'}>↗</a></div></div></section>
