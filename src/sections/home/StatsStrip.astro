---
import { tf } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import { groupStats } from '../../data/stats';
import Counter from '../../components/react/Counter.tsx';
import Reveal from '../../components/Reveal.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const locale = lang === 'fr' ? 'fr-FR' : 'en-US';
---

<section class="relative border-y border-[#23273d] bg-[#07080e]">
  <div class="container-page grid grid-cols-2 gap-px overflow-hidden lg:grid-cols-4">
    {
      groupStats.map((s, i) => (
        <Reveal delay={i * 0.08} class="relative bg-[#07080e] p-8 text-center sm:p-10">
          <div class="font-display text-[clamp(2.2rem,5vw,3.4rem)] font-bold text-white">
            <Counter
              client:visible
              value={s.value}
              prefix={s.prefix}
              suffix={s.suffix}
              locale={locale}
            />
          </div>
          <div class="mt-2 text-xs uppercase tracking-[0.18em] text-[#5c6180]">
            {tf(s.label, lang)}
          </div>
        </Reveal>
      ))
    }
  </div>
</section>
