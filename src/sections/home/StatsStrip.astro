---
import { tf } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import { groupStats } from '../../data/stats';
import Counter from '../../components/react/Counter.tsx';
import Reveal from '../../components/Reveal.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const locale = lang === 'fr' ? 'fr-FR' : 'en-US';
---

<section class="border-y border-[var(--color-line-cool)] bg-white">
  <div class="container-page grid grid-cols-2 divide-x divide-y divide-[var(--color-line-cool)] sm:divide-y-0 lg:grid-cols-4">
    {
      groupStats.map((s, i) => (
        <Reveal delay={i * 0.08} class="p-8 text-center sm:p-10">
          <div class="font-display text-[clamp(2.2rem,5vw,3.2rem)] font-bold text-[var(--color-navy)]">
            <Counter
              client:visible
              value={s.value}
              prefix={s.prefix}
              suffix={s.suffix}
              locale={locale}
            />
          </div>
          <div class="mt-2 text-xs uppercase tracking-[0.16em] text-[var(--color-muted)]">
            {tf(s.label, lang)}
          </div>
        </Reveal>
      ))
    }
  </div>
</section>
