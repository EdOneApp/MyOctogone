---
import type { Lang } from '../../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const fr = lang === 'fr';
---
<section id="groupe" class="group-intro section">
 <div class="container-page intro-grid">
  <div class="reveal"><span class="eyebrow">{fr ? '01 / LE GROUPE' : '01 / THE GROUP'}</span><p class="intro-location">Abidjan, Côte d’Ivoire<br /><span>{fr ? 'Un ancrage local. Une vision ouverte.' : 'Local roots. An open outlook.'}</span></p></div>
  <div class="reveal"><h2>{fr ? 'La force du collectif.' : 'The strength of a collective.'}<br /><span>{fr ? 'L’exigence du terrain.' : 'The rigour of the field.'}</span></h2><p class="intro-copy">{fr ? 'Octogone réunit huit métiers complémentaires autour d’une conviction : les bonnes idées prennent de la valeur lorsqu’elles deviennent des solutions concrètes. Technologie, infrastructures, services : nos expertises se rencontrent pour accompagner vos projets.' : 'Octogone brings eight complementary sectors together around a conviction: good ideas gain value when they become practical solutions. Technology, infrastructure and services: our expertise comes together to support your projects.'}</p><a class="text-link" href={lang === 'fr' ? '/a-propos/' : '/en/a-propos/'}>{fr ? 'Rencontrer Octogone' : 'Meet Octogone'} <span>↗</span></a></div>
 </div>
 <div class="container-page intro-numbers"><div><strong>08</strong><span>{fr ? 'métiers complémentaires' : 'complementary sectors'}</span></div><div><strong>01</strong><span>{fr ? 'vision commune' : 'shared vision'}</span></div><p>{fr ? 'La Boîte à Génies.' : 'The home of ingenuity.'}<br /><span>{fr ? 'Penser ensemble. Agir concrètement.' : 'Think together. Make it happen.'}</span></p></div>
</section>
