---
import { asset, localizePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const fr = lang === 'fr';
---
<section class="editorial-hero kinetic-hero">
 <img class="hero-photo" src={asset('images/architecture.jpg')} alt="" width="1920" height="1280" fetchpriority="high" />
 <div class="hero-shade"></div><div class="hero-aurora" aria-hidden="true"></div><div class="hero-mesh" aria-hidden="true"></div>
 <div class="container-page kinetic-inner">
  <div class="kinetic-copy"><p class="hero-kicker"><span></span>{fr ? 'OCTOGONE · LA BOÎTE À GÉNIES' : 'OCTOGONE · A HOME FOR INGENUITY'}</p><h1><span>{fr ? 'L’audace' : 'Bold ideas.'}</span><span>{fr ? 'd’imaginer.' : 'Real impact.'}</span><em>{fr ? 'La force d’agir.' : 'Built together.'}</em></h1><p class="kinetic-intro">{fr ? 'Du numérique aux infrastructures, nous connectons huit métiers pour transformer vos ambitions en réalisations.' : 'From digital products to infrastructure, we connect eight sectors to turn your ambitions into reality.'}</p><div class="kinetic-actions"><a href="#realisations" class="btn btn-amber">{fr ? 'Voir nos projets' : 'Explore our projects'} <span aria-hidden="true">↗</span></a><a href={localizePath('/a-propos',lang)} class="hero-about">{fr ? 'Découvrir le groupe' : 'Discover the group'} <span>→</span></a></div><div class="hero-proof"><span class="proof-avatar">08</span><p>{fr ? 'Des métiers qui se complètent.' : 'Complementary expertise.'}<br /><b>{fr ? 'Une ambition qui nous rassemble.' : 'One ambition that unites us.'}</b></p></div></div>
  <div class="hero-stage" aria-label={fr ? 'Aperçus de nos applications Edone et BanToo' : 'Previews of our Edone and BanToo applications'}>
   <div class="stage-orbit orbit-a" aria-hidden="true"></div><div class="stage-orbit orbit-b" aria-hidden="true"></div><span class="stage-spark spark-one" aria-hidden="true">✳</span><span class="stage-spark spark-two" aria-hidden="true">✳</span>
   <a href={localizePath('/projets/edone',lang)} class="floating-browser" data-depth="0.65"><div class="browser-chrome"><i></i><i></i><i></i><span>edone · {fr ? 'gestion scolaire' : 'school management'}</span><b>↗</b></div><div class="browser-screen"><img src={asset('images/portfolio/edone.webp')} alt={fr ? 'Capture réelle de la plateforme Edone' : 'Real screenshot of the Edone platform'} width="1500" height="950" /></div><div class="browser-bottom"><b>Edone</b><span>Web · Android · iOS</span><span class="live-dot"></span></div></a>
   <a class="floating-phone" data-depth="1.1" href={localizePath('/projets/edone',lang)} aria-label={fr ? 'Découvrir Edone sur mobile' : 'Discover Edone on mobile'}><div class="phone-island"></div><img src={asset('images/portfolio/edone-mobile.webp')} alt={fr ? 'Application mobile Edone' : 'Edone mobile app'} width="650" height="1250" /><div class="phone-home"></div></a>
   <a class="floating-mini" data-depth="0.4" href={localizePath('/projets/bantoo',lang)}><img src={asset('images/portfolio/bantoo.webp')} alt="BanToo" width="320" height="220" /><div><b>BanToo</b><span>{fr ? 'Le quotidien, simplifié.' : 'Everyday life, simplified.'}</span></div><span>↗</span></a>
   <div class="floating-award" data-depth="0.8"><span>✦</span><div><b>Moov Africa CI</b><small>StartUp Challenge 2025 · 1er prix</small></div></div>
   <span class="stage-coordinate">ABIDJAN / 05°20′ N · 04°01′ W</span>
  </div>
 </div>
 <div class="container-page kinetic-foot"><span><i></i> {fr ? 'HUIT MÉTIERS. UN MOUVEMENT.' : 'EIGHT SECTORS. ONE MOVEMENT.'}</span><a href="#groupe">{fr ? 'EXPLORER' : 'EXPLORE'} <span>↓</span></a></div>
</section>
<div class="expertise-ticker" aria-hidden="true"><div>{[0,1].map(()=> <span>TECHNOLOGIE <b>✳</b> INFRASTRUCTURES <b>✳</b> MOBILITÉ <b>✳</b> FINANCE <b>✳</b> AGRO-ALIMENTAIRE <b>✳</b> FORMATION <b>✳</b></span>)}</div></div>
