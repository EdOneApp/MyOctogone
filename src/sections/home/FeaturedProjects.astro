---
import { featuredProjects } from '../../data/projects';
import { asset, tf, localizePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const fr = lang === 'fr';
const projects = featuredProjects();
const group = (slug: string) => ['spaghetti-dabidjan','sportif-africa','bantoo'].includes(slug) ? 'commerce' : ['voltara','ivolt','allocar'].includes(slug) ? 'mobility' : ['xofa','momofund','wave-business-api-sdk','fne-ivoire'].includes(slug) ? 'finance' : ['pandatree','traceagrichain'].includes(slug) ? 'data' : 'platform';
const filters = fr ? [['all','Tous les projets'],['platform','Plateformes'],['commerce','Commerce & services'],['mobility','Mobilité'],['finance','Finance'],['data','Données & territoire']] : [['all','All projects'],['platform','Platforms'],['commerce','Commerce & services'],['mobility','Mobility'],['finance','Finance'],['data','Data & territory']];
---
<section id="realisations" class="section work-section portfolio-section">
 <div class="container-page">
  <div class="section-heading reveal"><div><span class="eyebrow">{fr ? '03 / DU CONCRET, PAS DES PROMESSES' : '03 / REAL PROJECTS, REAL IMPACT'}</span><h2>{fr ? 'Pensés ici.' : 'Conceived here.'}<br /><em>{fr ? 'Utilisés au quotidien.' : 'Used every day.'}</em></h2></div><p>{fr ? 'Des applications, des plateformes, des solutions de terrain. Explorez les projets et leurs interfaces.' : 'Applications, platforms and practical solutions. Explore our projects and their interfaces.'}</p></div>
  <div class="project-filter-bar"><div class="project-filters" role="group" aria-label={fr ? 'Filtrer les projets' : 'Filter projects'}>{filters.map(([value,label],i)=><button type="button" data-project-filter={value} aria-pressed={i===0}>{label}</button>)}</div><span class="project-count" aria-live="polite"><b data-project-count>{projects.length}</b> {fr ? 'projets' : 'projects'}</span></div>
  <div class="portfolio-grid">{projects.map((p,i)=><a class="portfolio-card reveal" data-project-category={group(p.slug)} href={localizePath(`/projets/${p.slug}`,lang)} style={`--card-order:${i%3};--project-tone:${['#dce6ed','#e8e4d7','#dfe7da','#e5def0'][i%4]}`}>
   <div class="portfolio-visual"><span class="portfolio-index">{String(i+1).padStart(2,'0')} / {String(projects.length)}</span><div class="project-browser"><div class="project-browser-bar"><i></i><i></i><i></i><span>{p.title.toLowerCase()}</span></div><img src={asset(p.image)} alt={`${fr ? 'Interface de' : 'Interface of'} ${p.title}`} loading="lazy" width="1500" height="950" /></div>{p.mobileImage && <div class="project-mini-phone"><img src={asset(p.mobileImage)} alt={`${p.title} mobile`} loading="lazy" width="650" height="1250" /></div>}<span class="portfolio-open" aria-hidden="true">↗</span>{p.award && <span class="portfolio-award">{tf(p.award,lang)}</span>}</div>
   <div class="portfolio-info"><span class="portfolio-category">{tf(p.category,lang)}</span><h3>{p.title}<span aria-hidden="true">↗</span></h3><p>{tf(p.summary,lang)}</p><div class="portfolio-tags">{p.stack.slice(0,3).map(tag=><span>{tag}</span>)}</div></div>
  </a>)}</div><p class="project-empty" hidden>{fr ? 'Aucun projet dans cette catégorie.' : 'No projects in this category.'}</p>
 </div>
</section>
