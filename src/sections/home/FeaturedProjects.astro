---
import { useTranslations, localizePath, tf, asset } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import { featuredProjects } from '../../data/projects';
import CardGrid, { type CardItem } from '../../components/react/CardGrid.tsx';
import Reveal from '../../components/Reveal.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const items: CardItem[] = featuredProjects().map((p, i) => ({
  index: String(i + 1).padStart(2, '0'),
  title: p.title,
  subtitle: tf(p.category, lang),
  description: tf(p.summary, lang),
  href: localizePath(`/projets/${p.slug}`, lang),
  image: asset(p.image),
  tags: p.stack,
  badge: p.award ? tf(p.award, lang) : undefined,
  cta: t('cta.viewProject'),
}));
---

<section id="realisations" class="section scroll-mt-24 bg-white">
  <div class="container-page">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <Reveal>
          <span class="eyebrow">{t('label.projects')}</span>
          <h2 class="mt-5 font-display text-[clamp(1.9rem,4vw,2.9rem)] font-bold text-[var(--color-ink)]">
            {t('home.featured.title')}
          </h2>
          <p class="mt-5 text-[var(--color-body)]">{t('home.featured.subtitle')}</p>
        </Reveal>
      </div>
      <a href={localizePath('/filiales/technologies', lang)} class="link-arrow">
        {t('cta.allProjects')}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <div class="mt-14">
      <CardGrid client:visible items={items} columns="sm:grid-cols-2 lg:grid-cols-3" />
    </div>
  </div>
</section>
