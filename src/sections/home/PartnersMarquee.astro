---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import { partners } from '../../data/partners';
import Marquee from '../../components/react/Marquee.tsx';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="border-y border-[var(--color-line-cool)] bg-white py-14">
  <div class="container-page">
    <p class="text-center text-xs font-semibold uppercase tracking-[0.24em] text-[var(--color-muted)]">
      {t('label.partners')}
    </p>
    <div class="mt-8">
      <Marquee client:visible items={partners} base={base} duration={44} />
    </div>
  </div>
</section>
