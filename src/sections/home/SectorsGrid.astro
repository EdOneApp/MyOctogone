---
import { subsidiaries } from '../../data/subsidiaries';
import { localizePath, tf, asset } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const fr = lang === 'fr';
const photos = ['images/collaboration.jpg','images/building.jpg','images/logistics.jpg','images/sector-finance.jpg','images/sector-agriculture.jpg','images/sector-transport.jpg','images/sector-training.jpg','images/sector-security.jpg'];
---
<section id="filiales" class="sectors-section section">
 <div class="container-page">
  <div class="section-heading reveal"><div><span class="eyebrow">{fr ? '02 / NOS MÉTIERS' : '02 / OUR SECTORS'}</span><h2>{fr ? 'Huit expertises.' : 'Eight areas of expertise.'}<br /><em>{fr ? 'Toutes connectées.' : 'All connected.'}</em></h2></div><p>{fr ? 'Une réponse spécialisée à chaque enjeu. La puissance d’un groupe pour aller plus loin.' : 'Specialist expertise for every challenge. The strength of a group to go further.'}</p></div>
  <div class="sector-editorial-grid">
   {subsidiaries.map((s,i) => <a class:list={['sector-panel','reveal', 'sector-photo']} href={localizePath(`/filiales/${s.slug}`,lang)}>
    {<img src={asset(photos[i])} alt="" loading="lazy" width="800" height="600" />}
    <div class="sector-top"><span>{String(i+1).padStart(2,'0')} / 08</span><span class="sector-arrow" aria-hidden="true">↗</span></div>
    <div class="sector-body"><h3>{tf(s.sector,lang)}</h3><p>{tf(s.tagline,lang)}</p></div>
   </a>)}
  </div>
 </div>
</section>
