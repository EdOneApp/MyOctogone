---
import { useTranslations, localizePath, tf } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import { subsidiaries } from '../../data/subsidiaries';
import { projectsBySubsidiary } from '../../data/projects';
import CardGrid, { type CardItem } from '../../components/react/CardGrid.tsx';
import Reveal from '../../components/Reveal.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const items: CardItem[] = subsidiaries.map((s, i) => ({
  index: String(i + 1).padStart(2, '0'),
  title: s.name,
  subtitle: tf(s.sector, lang),
  description: tf(s.tagline, lang),
  href: localizePath(`/filiales/${s.slug}`, lang),
  accent: s.accent,
  tags: [
    `${projectsBySubsidiary(s.slug).length} ${t('label.projects').toLowerCase()}`,
  ],
  cta: t('cta.explore'),
}));
---

<section id="filiales" class="relative scroll-mt-24 py-24 sm:py-32">
  <div class="container-page">
    <div class="max-w-2xl">
      <Reveal>
        <span class="eyebrow">{t('label.sectors')}</span>
        <h2 class="mt-5 font-display text-[clamp(2rem,4vw,3rem)] font-bold text-white">
          {t('home.sectors.title')}
        </h2>
        <p class="mt-5 text-[#8b90ad]">{t('home.sectors.subtitle')}</p>
      </Reveal>
    </div>

    <div class="mt-14">
      <CardGrid client:visible items={items} columns="sm:grid-cols-2 lg:grid-cols-4" variant="compact" />
    </div>
  </div>
</section>
