---
import { asset, localizePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const fr = lang === 'fr';
const steps = fr ? [['Comprendre','Votre contexte, vos objectifs, les réalités de votre métier. Tout commence par l’écoute.'],['Construire','Les bonnes expertises autour de la table, une feuille de route claire et des échanges réguliers.'],['Accompagner','Du premier échange à la mise en œuvre, une équipe impliquée à chaque étape.']] : [['Understand','Your context, your objectives and the realities of your industry. Everything starts with listening.'],['Build','The right expertise around the table, a clear roadmap and regular conversations.'],['Support','From the first conversation to implementation, a committed team at every step.']];
---
<section class="approach-section">
 <div class="approach-image"><img src={asset('images/collaboration.jpg')} alt={fr ? 'Échange autour d’un projet, photographie d’illustration' : 'Project discussion, illustrative photograph'} loading="lazy" width="1400" height="1000" /><span>{fr ? 'LE COLLECTIF FAIT LA DIFFÉRENCE.' : 'TOGETHER MAKES THE DIFFERENCE.'}</span></div>
 <div class="approach-content"><div class="reveal"><span class="eyebrow">{fr ? '04 / NOTRE APPROCHE' : '04 / OUR APPROACH'}</span><h2>{fr ? 'À vos côtés.' : 'By your side.'}<br /><em>{fr ? 'À chaque étape.' : 'At every step.'}</em></h2></div><div>{steps.map(([title,body],i) => <details class="approach-step" open={i === 0}><summary><span>0{i+1}</span><h3>{title}</h3><b aria-hidden="true">+</b></summary><p>{body}</p></details>)}</div><a class="text-link" href={localizePath('/contact',lang)}>{fr ? 'Parlons de votre projet' : 'Let’s discuss your project'} <span>↗</span></a></div>
</section>
