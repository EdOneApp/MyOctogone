---
import type { Lang } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import { legalPages, type LegalSlug } from '../data/legal';
interface Props { slug: LegalSlug; lang: Lang; }
const {slug,lang} = Astro.props;
const page = legalPages[slug][lang];
const fr = lang === 'fr';
---
<section class="legal-hero"><div class="container-page"><a href={localizePath('/',lang)} class="text-link">← {fr ? 'Retour à l’accueil' : 'Back to home'}</a><span class="eyebrow">OCTOGONE / {fr ? 'INFORMATIONS LÉGALES' : 'LEGAL INFORMATION'}</span><h1>{page.title}</h1><p>{page.intro}</p><span class="legal-date">{fr ? 'Dernière mise à jour : 26 octobre 2026' : 'Last updated: 26 October 2026'}</span></div><span class="legal-decoration" aria-hidden="true">✳</span></section>
<section class="legal-body section"><div class="container-page legal-grid"><aside><p>{fr ? 'SUR CETTE PAGE' : 'ON THIS PAGE'}</p><nav aria-label={fr ? 'Sommaire' : 'Contents'}>{page.sections.map((s,i)=><a href={`#article-${i+1}`}><span>{String(i+1).padStart(2,'0')}</span>{s.title}</a>)}</nav><a class="text-link" href={localizePath('/contact',lang)}>{fr ? 'Une question ?' : 'Any questions?'} ↗</a></aside><div class="legal-articles">{page.sections.map((s,i)=><section id={`article-${i+1}`}><span class="legal-number">{String(i+1).padStart(2,'0')}</span><h2>{s.title}</h2><p>{s.body}</p></section>)}{slug==='confidentialite' && <section class="legal-sources"><h2>{fr ? 'Ressources et prestataires' : 'Resources and providers'}</h2><a href="https://www.autoritedeprotection.ci/faqdcp/" target="_blank" rel="noopener noreferrer">{fr ? 'Autorité de protection des données, vos droits' : 'Data protection authority, your rights'} ↗</a><a href="https://www.whatsapp.com/legal/privacy-policy" target="_blank" rel="noopener noreferrer">WhatsApp ↗</a><a href="https://cal.com/privacy" target="_blank" rel="noopener noreferrer">Cal.com ↗</a><a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://developers.google.com/fonts/faq/privacy" target="_blank" rel="noopener noreferrer">Google Fonts ↗</a></section>}<div class="legal-contact"><span>↗</span><h2>{fr ? 'Restons en contact.' : 'Let’s stay in touch.'}</h2><a href="mailto:octogone.techs@gmail.com">octogone.techs@gmail.com</a></div></div></div></section>
