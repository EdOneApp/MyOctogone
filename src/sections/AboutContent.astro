---
import { useTranslations, localizePath, tf, asset } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { subsidiaries } from '../data/subsidiaries';
import { groupStats } from '../data/stats';
import { partners } from '../data/partners';
import Reveal from '../components/Reveal.astro';
import Counter from '../components/react/Counter.tsx';
import Marquee from '../components/react/Marquee.tsx';
import CTA from './CTA.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const locale = lang === 'fr' ? 'fr-FR' : 'en-US';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const values = [
  {
    fr: { t: 'Exécution', d: 'Nous sommes jugés sur ce que nous livrons, pas sur ce que nous promettons.' },
    en: { t: 'Execution', d: 'We are judged on what we deliver, not on what we promise.' },
  },
  {
    fr: { t: 'Ancrage local', d: 'Nos solutions sont pensées pour le contexte ivoirien et ouest-africain.' },
    en: { t: 'Local roots', d: 'Our solutions are designed for the Ivorian and West African context.' },
  },
  {
    fr: { t: 'Exigence', d: 'Un niveau de qualité international, sur chaque projet, quelle que soit sa taille.' },
    en: { t: 'Rigour', d: 'International quality standards, on every project, whatever its size.' },
  },
  {
    fr: { t: 'Transmission', d: 'Nous formons les talents dont nos filiales et le marché ont besoin.' },
    en: { t: 'Transmission', d: 'We train the talent our subsidiaries and the market need.' },
  },
];

const awards = [
  {
    img: 'assets/moov-stratup-challenge-2025-first-price.jpeg',
    fr: '1er Prix — Moov Africa CI StartUp Challenge 2025 (Edone)',
    en: '1st Prize — Moov Africa CI StartUp Challenge 2025 (Edone)',
  },
  {
    img: 'assets/moov-startupchallenge-2025-first-pirce-new.jpeg',
    fr: 'Lauréat Moov Africa CI StartUp Challenge 2025',
    en: 'Moov Africa CI StartUp Challenge 2025 winner',
  },
  {
    img: 'assets/proj_trace-agri-chain.jpg',
    fr: 'Finaliste — MASS / ICESCO 2025 (TraceAgriChain)',
    en: 'Finalist — MASS / ICESCO 2025 (TraceAgriChain)',
  },
];
---

<section class="relative overflow-hidden bg-[var(--color-cream)]">
  <div class="dot-grid absolute inset-0 opacity-60"></div>
  <div class="blob right-[-6%] top-0 h-[26rem] w-[26rem]" style="background: rgba(245,166,35,0.2)"></div>
  <div class="container-page relative pb-16 pt-36 lg:pt-44">
    <Reveal>
      <span class="eyebrow">{t('nav.group')}</span>
    </Reveal>
    <h1 class="mt-6 max-w-4xl font-display text-[clamp(2.3rem,5.4vw,4rem)] font-bold leading-[1.06] text-[var(--color-ink)]">
      {t('about.title')}
    </h1>
    <Reveal delay={0.1}>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[var(--color-body)]">{t('about.intro')}</p>
    </Reveal>
  </div>
</section>

<!-- Stats -->
<section class="border-y border-[var(--color-line-cool)] bg-white">
  <div class="container-page grid grid-cols-2 divide-x divide-y divide-[var(--color-line-cool)] sm:divide-y-0 lg:grid-cols-4">
    {
      groupStats.map((s, i) => (
        <Reveal delay={i * 0.08} class="p-8 text-center sm:p-10">
          <div class="font-display text-[clamp(2rem,5vw,3rem)] font-bold text-[var(--color-navy)]">
            <Counter client:visible value={s.value} suffix={s.suffix} prefix={s.prefix} locale={locale} />
          </div>
          <div class="mt-2 text-xs uppercase tracking-[0.14em] text-[var(--color-muted)]">{tf(s.label, lang)}</div>
        </Reveal>
      ))
    }
  </div>
</section>

<!-- Mission / Vision -->
<section class="section bg-white">
  <div class="container-page grid gap-6 md:grid-cols-2">
    <Reveal class="card p-8 sm:p-10">
      <h2 class="font-display text-xl font-bold text-[var(--color-ink)]">{t('about.mission.title')}</h2>
      <p class="mt-4 text-[var(--color-body)]">{t('about.mission.body')}</p>
    </Reveal>
    <Reveal delay={0.1} class="card p-8 sm:p-10">
      <h2 class="font-display text-xl font-bold text-[var(--color-ink)]">{t('about.vision.title')}</h2>
      <p class="mt-4 text-[var(--color-body)]">{t('about.vision.body')}</p>
    </Reveal>
  </div>
</section>

<!-- Values -->
<section class="section bg-[var(--color-cream)] pt-0">
  <div class="container-page">
    <Reveal>
      <h2 class="font-display text-[clamp(1.8rem,4vw,2.6rem)] font-bold text-[var(--color-ink)]">
        {t('about.values.title')}
      </h2>
    </Reveal>
    <Reveal stagger class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        values.map((v, i) => (
          <div class="card p-6">
            <span class="font-display text-sm font-semibold text-[var(--color-amber-600)]">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 font-display text-lg font-semibold text-[var(--color-ink)]">{v[lang].t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-body)]">{v[lang].d}</p>
          </div>
        ))
      }
    </Reveal>
  </div>
</section>

<!-- Subsidiaries -->
<section class="section bg-white">
  <div class="container-page">
    <Reveal>
      <span class="eyebrow">{t('label.sectors')}</span>
      <h2 class="mt-5 font-display text-[clamp(1.8rem,4vw,2.6rem)] font-bold text-[var(--color-ink)]">
        {lang === 'fr' ? 'Huit filiales' : 'Eight subsidiaries'}
      </h2>
    </Reveal>
    <Reveal stagger class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        subsidiaries.map((s, i) => (
          <a
            href={localizePath(`/filiales/${s.slug}`, lang)}
            class="card card-hover flex h-full flex-col p-5"
          >
            <span class="icon-tile mb-4 h-14 w-14">
              <img src={asset(s.icon)} alt="" aria-hidden="true" class="h-9 w-9 object-contain" loading="lazy" />
            </span>
            <span class="font-display text-xs font-semibold tracking-[0.16em] text-[var(--color-faint)]">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="mt-1 font-display text-base font-semibold text-[var(--color-ink)]">{tf(s.sector, lang)}</span>
            <span class="mt-1.5 flex-1 text-xs leading-relaxed text-[var(--color-body)]">{tf(s.tagline, lang)}</span>
            <span class="link-arrow mt-4">{t('cta.explore')}</span>
          </a>
        ))
      }
    </Reveal>
  </div>
</section>

<!-- Awards -->
<section class="section bg-[var(--color-cream)] pt-0">
  <div class="container-page">
    <Reveal>
      <span class="eyebrow">{t('label.award')}</span>
    </Reveal>
    <Reveal stagger class="mt-8 grid gap-5 sm:grid-cols-3">
      {
        awards.map((a) => (
          <figure class="card overflow-hidden">
            <img src={asset(a.img)} alt={a[lang]} class="aspect-[4/3] w-full object-cover" />
            <figcaption class="p-4 text-sm text-[var(--color-body)]">{a[lang]}</figcaption>
          </figure>
        ))
      }
    </Reveal>
  </div>
</section>

<!-- Partners -->
<section class="border-y border-[var(--color-line-cool)] bg-white py-14">
  <div class="container-page">
    <p class="text-center text-xs font-semibold uppercase tracking-[0.24em] text-[var(--color-muted)]">{t('label.partners')}</p>
    <div class="mt-8">
      <Marquee client:visible items={partners} base={base} duration={44} />
    </div>
  </div>
</section>

<CTA lang={lang} />
