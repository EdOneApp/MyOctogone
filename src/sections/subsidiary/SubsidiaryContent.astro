---
import { useTranslations, localizePath, tf, asset } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import type { Subsidiary } from '../../data/types';
import { subsidiaries } from '../../data/subsidiaries';
import { projectsBySubsidiary } from '../../data/projects';
import CardGrid, { type CardItem } from '../../components/react/CardGrid.tsx';
import Reveal from '../../components/Reveal.astro';
import GradientText from '../../components/react/GradientText.tsx';
import CTA from '../CTA.astro';

interface Props {
  subsidiary: Subsidiary;
  lang: Lang;
}
const { subsidiary: s, lang } = Astro.props;
const t = useTranslations(lang);

const projects = projectsBySubsidiary(s.slug);
const projectItems: CardItem[] = projects.map((p, i) => ({
  index: String(i + 1).padStart(2, '0'),
  title: p.title,
  subtitle: tf(p.category, lang),
  description: tf(p.summary, lang),
  href: localizePath(`/projets/${p.slug}`, lang),
  image: p.status === 'verified' ? asset(p.image) : undefined,
  accent: s.accent,
  tags: p.stack,
  badge: p.award ? tf(p.award, lang) : undefined,
  cta: t('cta.viewProject'),
}));

const others = subsidiaries.filter((x) => x.slug !== s.slug);
const idx = subsidiaries.findIndex((x) => x.slug === s.slug);
---

<!-- Hero -->
<section class="bg-noise relative isolate overflow-hidden">
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute inset-0 bg-[#05060a]"></div>
    <img
      src={asset(s.heroImage)}
      alt=""
      aria-hidden="true"
      class="absolute right-0 top-0 h-full w-[55%] scale-125 object-cover opacity-[0.06] blur-2xl [mask-image:linear-gradient(90deg,transparent,#000_60%)]"
    />
    <div class="bg-grid absolute inset-0 opacity-90"></div>
    <div
      class="oct-ring right-[-14rem] top-[-12rem] h-[40rem] w-[40rem]"
      style={`border-color:${s.accent.from}22`}
    >
    </div>
    <div
      class="glow-blob left-[-6%] top-[8%] h-[42rem] w-[42rem]"
      style={`background: radial-gradient(circle, ${s.accent.from}bb, transparent 62%)`}
    >
    </div>
    <div
      class="glow-blob right-[-4%] bottom-[-10%] h-[34rem] w-[34rem]"
      style={`background: radial-gradient(circle, ${s.accent.to}99, transparent 62%)`}
    >
    </div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[#05060a] to-transparent"></div>
  </div>

  <div class="container-page relative flex min-h-[78vh] flex-col justify-center pb-20 pt-36">
    <Reveal>
      <a href={`${localizePath('/', lang)}#filiales`} class="link-arrow mb-8 text-[#8b90ad]">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        {t('label.subsidiaries')}
      </a>
      <div class="flex items-center gap-3">
        <span
          class="clip-octagon-sm inline-flex items-center px-3 py-1.5 font-display text-xs font-semibold uppercase tracking-[0.2em]"
          style={`color:${s.accent.from}; border:1px solid ${s.accent.from}40; background:${s.accent.from}12`}
        >
          {t('label.subsidiary')} {String(idx + 1).padStart(2, '0')} / 08
        </span>
        <span class="text-xs uppercase tracking-[0.24em] text-[#5c6180]">{tf(s.sector, lang)}</span>
      </div>
    </Reveal>

    <h1 class="mt-6 max-w-4xl font-display text-[clamp(2.4rem,6vw,4.6rem)] font-bold leading-[1.04] text-white">
      <GradientText client:load text={s.name} />
    </h1>
    <Reveal delay={0.12}>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[#c7cbe0]">{tf(s.tagline, lang)}</p>
    </Reveal>

    <Reveal delay={0.2} class="mt-10 flex flex-wrap gap-3">
      {
        s.figures.map((f) => (
          <div class="glass clip-octagon-sm px-5 py-3">
            <div class="font-display text-xl font-bold text-white">{f.value}</div>
            <div class="text-[0.68rem] uppercase tracking-[0.14em] text-[#5c6180]">
              {tf(f.label, lang)}
            </div>
          </div>
        ))
      }
    </Reveal>
  </div>
</section>

<!-- Intro + capabilities -->
<section class="py-24 sm:py-28">
  <div class="container-page grid gap-14 lg:grid-cols-[1fr_1.1fr]">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <Reveal>
        <span class="eyebrow">{t('nav.group')}</span>
        <div class="mt-5 space-y-4">
          {s.intro.map((para) => <p class="text-[#c7cbe0]">{tf(para, lang)}</p>)}
        </div>
      </Reveal>
    </div>

    <Reveal stagger>
      <h2 class="mb-6 font-display text-2xl font-bold text-white">{t('label.capabilities')}</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          s.capabilities.map((c) => (
            <div class="glass clip-octagon-sm h-full p-5">
              <div
                class="clip-octagon-sm mb-3 grid h-9 w-9 place-items-center"
                style={`background:${s.accent.from}18; color:${s.accent.from}`}
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M7.5 3h9L21 7.5v9L16.5 21h-9L3 16.5v-9L7.5 3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                </svg>
              </div>
              <h3 class="font-display text-base font-semibold text-white">{tf(c.title, lang)}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-[#8b90ad]">{tf(c.description, lang)}</p>
            </div>
          ))
        }
      </div>
    </Reveal>
  </div>
</section>

<!-- Projects -->
{
  projectItems.length > 0 && (
    <section class="py-16 sm:py-20">
      <div class="container-page">
        <Reveal>
          <span class="eyebrow">{t('label.projects')}</span>
          <h2 class="mt-5 font-display text-[clamp(1.8rem,4vw,2.6rem)] font-bold text-white">
            {lang === 'fr' ? 'Réalisations de la filiale' : 'Work from this subsidiary'}
          </h2>
        </Reveal>
        <div class="mt-12">
          <CardGrid client:visible items={projectItems} columns="sm:grid-cols-2 lg:grid-cols-3" />
        </div>
      </div>
    </section>
  )
}

<!-- Other subsidiaries -->
<section class="py-16 sm:py-20">
  <div class="container-page">
    <h2 class="font-display text-xs font-semibold uppercase tracking-[0.22em] text-[#5c6180]">
      {t('label.subsidiaries')}
    </h2>
    <div class="mt-6 flex flex-wrap gap-3">
      {
        others.map((o) => (
          <a
            href={localizePath(`/filiales/${o.slug}`, lang)}
            class="chip !px-4 !py-2 transition-colors hover:border-cyan-400/60 hover:text-white"
          >
            {tf(o.sector, lang)}
          </a>
        ))
      }
    </div>
  </div>
</section>

<CTA lang={lang} />
