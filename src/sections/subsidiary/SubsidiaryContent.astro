---
import { useTranslations, localizePath, tf, asset } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import type { Subsidiary } from '../../data/types';
import { subsidiaries } from '../../data/subsidiaries';
import { projectsBySubsidiary } from '../../data/projects';
import CardGrid, { type CardItem } from '../../components/react/CardGrid.tsx';
import Reveal from '../../components/Reveal.astro';
import CTA from '../CTA.astro';

interface Props {
  subsidiary: Subsidiary;
  lang: Lang;
}
const { subsidiary: s, lang } = Astro.props;
const t = useTranslations(lang);

const projects = projectsBySubsidiary(s.slug);
const projectItems: CardItem[] = projects.map((p, i) => ({
  index: String(i + 1).padStart(2, '0'),
  title: p.title,
  subtitle: tf(p.category, lang),
  description: tf(p.summary, lang),
  href: localizePath(`/projets/${p.slug}`, lang),
  image: p.status === 'verified' ? asset(p.image) : undefined,
  tags: p.stack,
  badge: p.award ? tf(p.award, lang) : undefined,
  cta: t('cta.viewProject'),
}));

const others = subsidiaries.filter((x) => x.slug !== s.slug);
const idx = subsidiaries.findIndex((x) => x.slug === s.slug);
---

<!-- Hero -->
<section class="relative overflow-hidden bg-[var(--color-cream)]">
  <div class="dot-grid absolute inset-0 opacity-60"></div>
  <div class="blob right-[-6%] top-[4%] h-[28rem] w-[28rem]" style="background: rgba(245,166,35,0.2)"></div>

  <div class="container-page relative pb-16 pt-36 lg:pt-44">
    <Reveal>
      <a href={`${localizePath('/', lang)}#filiales`} class="link-arrow mb-8 text-[var(--color-muted)]">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        {t('label.subsidiaries')}
      </a>
    </Reveal>

    <div class="grid items-center gap-10 lg:grid-cols-[1fr_auto]">
      <div>
        <span class="chip chip-amber">
          {t('label.subsidiary')} {String(idx + 1).padStart(2, '0')} / 08 · {tf(s.sector, lang)}
        </span>
        <h1 class="mt-5 font-display text-[clamp(2.4rem,5.6vw,4.2rem)] font-bold leading-[1.06] text-[var(--color-ink)]">
          {s.name}
        </h1>
        <Reveal delay={0.1}>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-[var(--color-body)]">{tf(s.tagline, lang)}</p>
        </Reveal>
      </div>
      <div class="icon-tile hidden h-40 w-40 shrink-0 lg:grid">
        <img src={asset(s.icon)} alt="" aria-hidden="true" class="h-24 w-24 object-contain" />
      </div>
    </div>

    <Reveal delay={0.18} class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        s.figures.map((f) => (
          <div class="card p-5">
            <div class="font-display text-2xl font-bold text-[var(--color-navy)]">{f.value}</div>
            <div class="mt-1 text-[0.7rem] uppercase tracking-[0.12em] text-[var(--color-muted)]">
              {tf(f.label, lang)}
            </div>
          </div>
        ))
      }
    </Reveal>
  </div>
</section>

<!-- Intro + capabilities -->
<section class="section bg-white">
  <div class="container-page grid gap-14 lg:grid-cols-[1fr_1.1fr]">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <Reveal>
        <span class="eyebrow">{t('nav.group')}</span>
        <div class="mt-5 space-y-4">
          {s.intro.map((para) => <p class="text-[var(--color-body)]">{tf(para, lang)}</p>)}
        </div>
      </Reveal>
    </div>

    <Reveal stagger>
      <h2 class="mb-6 font-display text-2xl font-bold text-[var(--color-ink)]">{t('label.capabilities')}</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          s.capabilities.map((c) => (
            <div class="card p-5">
              <div class="mb-3 grid h-9 w-9 place-items-center rounded-lg bg-[var(--color-amber-100)] text-[var(--color-amber-600)]">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 12l5 5L20 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <h3 class="font-display text-base font-semibold text-[var(--color-ink)]">{tf(c.title, lang)}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-body)]">{tf(c.description, lang)}</p>
            </div>
          ))
        }
      </div>
    </Reveal>
  </div>
</section>

<!-- Projects -->
{
  projectItems.length > 0 && (
    <section class="section bg-[var(--color-cream)]">
      <div class="container-page">
        <Reveal>
          <span class="eyebrow">{t('label.projects')}</span>
          <h2 class="mt-5 font-display text-[clamp(1.8rem,4vw,2.6rem)] font-bold text-[var(--color-ink)]">
            {lang === 'fr' ? 'Réalisations de la filiale' : 'Work from this subsidiary'}
          </h2>
        </Reveal>
        <div class="mt-12">
          <CardGrid client:visible items={projectItems} columns="sm:grid-cols-2 lg:grid-cols-3" />
        </div>
      </div>
    </section>
  )
}

<!-- Other subsidiaries -->
<section class="section bg-white">
  <div class="container-page">
    <h2 class="font-display text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-muted)]">
      {t('label.subsidiaries')}
    </h2>
    <div class="mt-6 flex flex-wrap gap-3">
      {
        others.map((o) => (
          <a
            href={localizePath(`/filiales/${o.slug}`, lang)}
            class="chip !px-4 !py-2 transition-colors hover:border-[var(--color-navy)] hover:text-[var(--color-navy)]"
          >
            {tf(o.sector, lang)}
          </a>
        ))
      }
    </div>
  </div>
</section>

<CTA lang={lang} />
